# Unsplash API access key — https://unsplash.com/oauth/applications
#
# Server-side only: it is read in lib/unsplash.js during rendering and is
# deliberately NOT prefixed with NEXT_PUBLIC_, so it never reaches the browser.
#
# Copy this file to .env.local and fill in the key. Note that a Demo app is
# capped at 50 requests/hour, which is not enough for a full first render of a
# ~100 photo account (see README → Photography).
UNSPLASH_ACCESS_KEY=
